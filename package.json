{
  "name": "universal-scheme-validator",
  "version": "0.0.5",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "*.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "package",
    "validator",
    "validation",
    "typescript",
    "schema",
    "validator-scheme",
    "validator-node"
  ],
  "author": "Seerendo",
  "license": "MIT",
  "description": "Validation schemas for class-based data models",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "prettier --write"
    ]
  },
  "repository": {
    "url": "https://github.com/Seerendo/universal-scheme-validator.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/Seerendo/universal-scheme-validator/issues"
  },
  "homepage": "https://github.com/Seerendo/universal-scheme-validator#readme"
}
